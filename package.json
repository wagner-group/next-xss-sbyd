{
  "name": "next-xss-sbyd-workspace",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "eslint-plugin-next-xss-sbyd"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "check": "npm run test:toolchain && npm run test:react && npm run typecheck && npm run test:runtime && npm run test:eslint && npm run test:types && npm run test:duplicate && npm run test:compat && npm run test:sanitize-browser && npm run test:frame-browser && npm run test:markdown-browser",
    "test:compat": "npm run build && node scripts/test-compatibility.mjs",
    "test:duplicate": "node scripts/test-duplicate-safevalues.mjs",
    "test:runtime": "npm run build && node --test tests/*.test.mjs",
    "test:eslint": "npm run build --workspace eslint-plugin-next-xss-sbyd && node --test eslint-plugin-next-xss-sbyd/tests/*.test.mjs",
    "test:types": "node scripts/test-type-fixtures.mjs",
    "typecheck": "tsc -b",
    "test:passive-browser": "npm run build && node scripts/test-passive-content-browser.mjs",
    "test:sanitize-browser": "npm run build && node scripts/test-sanitize-browser.mjs",
    "test:toolchain": "node --test scripts/test-toolchain.mjs",
    "test:react": "node --test scripts/test-react-compatibility.mjs",
    "test:frame-browser": "npm run build && node scripts/test-sanitized-frame-browser.mjs",
    "test:markdown-browser": "npm run build && node scripts/test-markdown-browser.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@typescript-eslint/parser": "8.70.0",
    "compression": "1.8.2",
    "esbuild": "^0.28.2",
    "eslint": "10.10.0",
    "eslint9": "npm:eslint@9.39.5",
    "playwright-core": "1.62.1",
    "typescript": "~6.0.3",
    "semver": "^7.8.5"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || ^26.0.0"
  }
}
